+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <vm/vm_shared_region.h>
+#include <arm/thread.h>
+
+/*
+ * SWEET crash report on the console. The phone has no way to get crash
+ * logs off the device, and corpses stop after a few crashes, so print what
+ * symbolication needs: user registers, a frame-pointer backtrace, the
+ * shared cache slide (unslid = pc - slide) and the main binary's Mach-O
+ * header (offset = pc - mh). Called from proc_prepareexit on the exiting
+ * (crashing) thread.
+ */
+void sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
+
+void
+sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("CRASH %s[%d] sig %d code 0x%llx sub 0x%llx slide 0x%llx mh 0x%llx\n",
+	    name, pid, sig, code, subcode, slide, mh);
+
+	/*
+	 * The persistent-log thread only flushes once a second; a process that
+	 * dies in its first second would never reach the userdata ring. Push
+	 * everything out now so recovery can read the reason for the kill.
+	 */
+	{
+		extern void sweet_log_flush(void);
+		sweet_log_flush();
+	}
+
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	uint64_t fp = get_saved_state_fp(ss);
+	printf("CRASH %s pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx\n", name,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss), fp,
+	    (uint64_t)saved_state64(ss)->far);
+
+	/*
+	 * Is the pc real code or a wild jump? Dump the bytes it points at and
+	 * the mapping that contains it (file-backed mappings have a file
+	 * offset; anonymous ones print off 0).
+	 */
+	{
+		unsigned char ins[16];
+		vm_map_t map = current_map();
+		vm_map_entry_t entry;
+
+		if (!copyin((user_addr_t)get_saved_state_pc(ss), ins, sizeof(ins))) {
+			printf("CRASH %s code@pc %016llx %016llx\n", name,
+			    *(uint64_t *)ins, *(uint64_t *)(ins + 8));
+		} else {
+			printf("CRASH %s code@pc unreadable\n", name);
+		}
+		vm_map_lock_read(map);
+		if (vm_map_lookup_entry(map, (vm_map_offset_t)get_saved_state_pc(ss), &entry) &&
+		    entry != vm_map_to_entry(map)) {
+			printf("CRASH %s pc map 0x%llx-0x%llx prot %d/%d tag %d\n",
+			    name, (uint64_t)entry->vme_start, (uint64_t)entry->vme_end,
+			    entry->protection, entry->max_protection, (int)VME_ALIAS(entry));
+		} else {
+			printf("CRASH %s pc map: none\n", name);
+		}
+		if (entry != vm_map_to_entry(map) && (entry->protection & VM_PROT_EXECUTE)) {
+			unsigned char hdr[32];
+			if (!copyin((user_addr_t)entry->vme_start, hdr, sizeof(hdr))) {
+				printf("CRASH %s map hdr %016llx %016llx %016llx %016llx\n", name,
+				    *(uint64_t *)hdr, *(uint64_t *)(hdr + 8),
+				    *(uint64_t *)(hdr + 16), *(uint64_t *)(hdr + 24));
+			}
+		}
+		vm_map_unlock_read(map);
+	}
+	{
+		uint64_t *r = saved_state64(ss)->x;
+		printf("CRASH %s regs %llx %llx %llx %llx %llx %llx %llx %llx\n", name,
+		    r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]);
+		printf("CRASH %s regs2 %llx %llx %llx %llx %llx %llx\n", name,
+		    r[8], r[9], r[10], r[11], r[12], r[13]);
+		printf("CRASH %s regs3 %llx %llx %llx %llx %llx %llx %llx %llx\n", name,
+		    r[14], r[15], r[16], r[17], r[18], r[19], r[20], r[21]);
+		if (r[19] != 0) {
+			unsigned char cfg[64];
+			if (!copyin((user_addr_t)(r[19] + 0x1a80), cfg, sizeof(cfg))) {
+				printf("CRASH %s cfg %016llx %016llx %016llx %016llx\n", name,
+				    *(uint64_t *)cfg, *(uint64_t *)(cfg + 8),
+				    *(uint64_t *)(cfg + 16), *(uint64_t *)(cfg + 24));
+				printf("CRASH %s cfg2 %016llx %016llx %016llx %016llx\n", name,
+				    *(uint64_t *)(cfg + 32), *(uint64_t *)(cfg + 40),
+				    *(uint64_t *)(cfg + 48), *(uint64_t *)(cfg + 56));
+			}
+		}
+	}
+
+	char line[200];
+	int n = snprintf(line, sizeof(line), "CRASH %s bt", name);
+	for (int i = 0; i < 10 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
