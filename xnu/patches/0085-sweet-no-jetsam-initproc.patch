--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -5449,5 +5449,17 @@
 memorystatus_kill_proc(proc_t p, uint32_t cause, os_reason_t jetsam_reason, bool *killed, uint64_t *footprint_of_killed_proc)
 {
 	pid_t aPid = 0;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	extern proc_t initproc;
+	if (p == initproc) {
+		/*
+		 * The filecache/pressure heuristics misfire on this port (4 GB
+		 * free and the system is declared unhealthy), and killing pid 1
+		 * panics the kernel. Refuse; the caller picks another victim.
+		 */
+		memorystatus_log_error("memorystatus: refusing to jetsam initproc (cause %u)\n", cause);
+		return FALSE;
+	}
+#endif
 	uint32_t aPid_ep = 0;

 	uint64_t        killtime = 0;
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1802,4 +1802,24 @@
 		    exit_reason_desc : "none");
 	}

+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (p == initproc) {
+		/*
+		 * launchd is about to die and this function is about to panic.
+		 * The panic path's kprintf never reaches the persistent ring, so
+		 * print the crash report and flush it to userdata while there is
+		 * still a functioning UFS path.
+		 */
+		extern void sweet_crash_log(const char *, int, int, uint64_t, uint64_t);
+		extern void sweet_log_flush(void);
+		uint64_t sweet_reason = 0;
+		if (p->p_exit_reason != OS_REASON_NULL) {
+			sweet_reason = ((uint64_t)p->p_exit_reason->osr_namespace << 32) |
+			    (uint32_t)p->p_exit_reason->osr_code;
+		}
+		sweet_crash_log(p->p_name, proc_getpid(p), WTERMSIG(rv), sweet_reason, 0);
+		sweet_log_flush();
+	}
+#endif
+
 	const char *prefix_str;
 	char prefix_str_buf[128];
